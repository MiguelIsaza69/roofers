# ==============================================================
# Unity .gitignore (based on github/gitignore Unity template)
# Place at the project root.
# ==============================================================

# Unity-generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Asset meta data should ONLY be ignored when its asset is also ignored.
# This keeps .meta files versioned for everything under Assets/.
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / editor caches
.vs/
.vscode/
.idea/
.gradle/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
crashlytics-build.properties

# Builds / packaged output
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta

# Addressables packed content
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Environment / local config
.env
.env.local

# Local player saves (career data is written to persistentDataPath, but ignore
# any stray copies inside the project tree just in case)
/[Ss]aves/
*.save

# Vendored third-party packages imported into Assets/ (re-import in the Editor on a
# fresh clone — see DEPENDENCIES_SETUP.md). Keeps ~1900 library files out of history.
# Remove this block if you prefer to vendor Mirror in the repo.
/[Aa]ssets/Mirror/
/[Aa]ssets/Mirror.meta

# NOTE: intentionally NOT ignored (must be versioned):
#   - ProjectSettings/        (project configuration)
#   - Packages/manifest.json  (package dependencies)
#   - Packages/packages-lock.json
#   - Assets/**/*.meta         (asset GUIDs)
